# Copy to .env.local and fill in real values. Never commit real secrets.

# LLM
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# API / app
PORT=8050
HOST=0.0.0.0
API_URL=http://127.0.0.1:8050
JWT_SECRET_KEY=replace-with-a-long-random-string

# Optional bootstrap admin (only used when the user store is empty)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# Database (optional — falls back to JSON if unset/unavailable)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Vector store
VECTOR_STORE=chroma
# VECTOR_STORE=pgvector
