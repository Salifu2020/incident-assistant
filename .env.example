# Copy to .env.local and fill in real values. Never commit real secrets.

# LLM
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# API / app
PORT=8050
HOST=0.0.0.0
API_URL=http://127.0.0.1:8050
JWT_SECRET_KEY=replace-with-a-long-random-string

# Optional bootstrap admin (only used when the user store is empty)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# One-click reviewer login on Streamlit (set to 0 to disable)
ENABLE_DEMO_LOGIN=1
DEMO_EMAIL=demo@incident-assistant.local
DEMO_PASSWORD=DemoReviewer!2024
DEMO_FIRST_NAME=Demo

# Local persistence (recommended for this machine)
# USE_LOCAL_STORAGE=1 keeps users and chats in data/ and skips remote Postgres
USE_LOCAL_STORAGE=1

# Database (optional — only used when USE_LOCAL_STORAGE is off)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Vector store
VECTOR_STORE=chroma
# VECTOR_STORE=pgvector
